d>\n<td>Cha.sa.Chi.26/217\n</td>\n<td>Used in Kavala in  Arochaka.\n</td></tr>\n<tr>\n<td>78\n</td>\n<td>Cha.sa.Chi.26/219\n</td>\n<td>As an ingredient of Arochakanashaka vati.\n</td></tr>\n<tr>\n<td>79\n</td>\n<td>Cha.Sa.Chi.28/132\n</td>\n<td>As an ingredient of Triphaladi maha sneha.\n</td></tr>\n<tr>\n<td>80\n</td>\n<td>Cha.Sa.Chi.30/79\n</td>\n<td>As an ingredient of Dhatakyadi taila.\n</td></tr>\n</tbody></table>\n<h2><span class=\"mw-headline\" id=\"Ayurvedic_pharmacological_properties\">Ayurvedic pharmacological properties</span></h2>\n<table class=\"wikitable\">\n<caption>Properties\n</caption>\n<tbody><tr>\n<th>Sr.no.</th>\n<th>Pharmacological criteria</th>\n<th>Properties\n</th></tr>\n<tr>\n<td>1</td>\n<td>Taste (<a href=\"/index.php?title=Rasa\" title=\"Rasa\">rasa</a>)</td>\n<td>Sweet (madhura), Astringent (kashaya), Sour (amla)\n</td></tr>\n<tr>\n<td>2</td>\n<td>Potency (<a href=\"/index.php?title=Veerya\" title=\"Veerya\">veerya</a>)</td>\n<td>Not too hot (anushna)\n</td></tr>\n<tr>\n<td>3</td>\n<td>Post digestion effect (<a href=\"/index.php?title=Vipaka\" title=\"Vipaka\">vipaka</a>)</td>\n<td>Sweet (madhura)\n</td></tr>\n<tr>\n<td>4</td>\n<td>Qualities (<a href=\"/index.php?title=Guna\" title=\"Guna\">guna</a>)</td>\n<td>Light (laghu), Unctuous (snigdha)\n</td></tr>\n<tr>\n<td>5</td>\n<td>Actions (<a href=\"/index.php?title=Karma\" title=\"Karma\">karma</a>)</td>\n<td>Reduces <a href=\"/index.php?title=Vata\" class=\"mw-redirect\" title=\"Vata\">vata</a>, <a href=\"/index.php?title=Pitta\" title=\"Pitta\">pitta</a> and <a href=\"/index.php?title=Kapha\" class=\"mw-redirect\" title=\"Kapha\">kapha</a>\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Current_availability\">Current availability</span></h2>\n<p>Available \n</p>\n<h2><span class=\"mw-headline\" id=\"Current_researches\">Current researches</span></h2>\n<pre> This article is under development ..\n</pre>\n<!-- \nNewPP limit report\nCached time: 20250917123827\nCache expiry