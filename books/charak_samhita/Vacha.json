>\n<td>Cha.Sa.Chi.23/80\n</td>\n<td>As an ingredient of Maha -Gandha hasti agada.\n</td></tr>\n<tr>\n<td>72\n</td>\n<td>Cha.Sa.Chi.23/212\n</td>\n<td>Used in the treatment of Vishvambhara etc. kita  poison.\n</td></tr>\n<tr>\n<td>73\n</td>\n<td>Cha.sa.Chi.26/20\n</td>\n<td>As an ingredient of  Dviruttarahingvadi churna.\n</td></tr>\n<tr>\n<td>74\n</td>\n<td>Cha.sa.Chi.26/21\n</td>\n<td>As an ingredient of  Vachadi churna\n</td></tr>\n<tr>\n<td>75\n</td>\n<td>Cha.sa.Chi.26/22\n</td>\n<td>As an ingredient of 2<sup>nd</sup>  Dviruttarahingvadi churna.\n</td></tr>\n<tr>\n<td>76\n</td>\n<td>Cha.sa.Chi.26/61\n</td>\n<td>As an ingredient of  Pashanbhedadi churna\n</td></tr>\n<tr>\n<td>77\n</td>\n<td>Cha.sa.Chi.26/85\n</td>\n<td>As an ingredient of  Pushkarmuladi yoga.\n</td></tr>\n<tr>\n<td>78\n</td>\n<td>Cha.sa.Chi.26/97\n</td>\n<td>Used in kaphaja hrudroga.\n</td></tr>\n<tr>\n<td>79\n</td>\n<td>Cha.sa.Chi.26/138\n</td>\n<td>Used in Vataja Pratishyaya  for Nasya karma.\n</td></tr>\n<tr>\n<td>80\n</td>\n<td>Cha.sa.Chi.26/152\n</td>\n<td>Used in Kaphaja  Pratishyaya for Pradhamana nasya.\n</td></tr>\n<tr>\n<td>81\n</td>\n<td>Cha.sa.Chi.26/153\n</td>\n<td>As an ingredient of  Bhargyadi taila.\n</td></tr>\n<tr>\n<td>82\n</td>\n<td>Cha.sa.Chi.26/209\n</td>\n<td>As an ingredient of Khadiradi gutika.\n</td></tr>\n<tr>\n<td>83\n</td>\n<td>Cha.sa.Chi.26/223\n</td>\n<td>As an ingredient of  Devadarvyadi taila for Karnashoola.\n</td></tr>\n<tr>\n<td>84\n</td>\n<td>Cha.sa.Chi.26/226\n</td>\n<td>As an ingredient of Kshara taila.\n</td></tr>\n<tr>\n<td>85\n</td>\n<td>Cha.Sa.Chi.27/31\n</td>\n<td>As an ingredient  of Urustambha nashak Yoga\n</td></tr>\n<tr>\n<td>86\n</td>\n<td>Cha.Sa.Chi.27/36\n</td>\n<td>As an ingredient  of Swarnakshiradi yoga\n</td></tr>\n<tr>\n<td>87\n</td>\n<td>Cha.Sa.Chi.27/41\n</td>\n<td>As an ingredient  of Piluparnyadi Yoga\n</td></tr>\n<tr>\n<td>88\n</td>\n<td>Cha.Sa.Chi.28/154\n</td>\n<td>As an ingredient of Bala taila.\n</td></tr>\n<tr>\n<td>89\n</td>\n<td>Cha.Sa.Chi.28/161\n</td>\n<td>As an ingredient of Amrutadi taila.\n</td></tr>\n<tr>\n<td>90\n</td>\n<td>Cha.Sa.Chi.28/168\n</td>\n<td>As an ingredient of Mulakadhya taila.\n</td></tr>\n<tr>\n<td>91\n</td>\n<td>Cha.Sa.chi.29/149\n</td>\n<td>Apply lepa for Vatakaphaja Vatarakta.\n</td></tr>\n<tr>\n<td>92\n</td>\n<td>Cha.Sa.chi.29/152\n</td>\n<td>As an ingredient of Triphaladi kalka in tridoshaja shola.\n</td></tr>\n<tr>\n<td>93\n</td>\n<td>Cha.Sa.Chi.30/54\n</td>\n<td>As an ingredient of Pippalyadi yoga.\n</td></tr>\n<tr>\n<td>94\n</td>\n<td>Cha.Sa.Chi.30/252\n</td>\n<td>Used in the treatment of Stanya dosha, for vamana.\n</td></tr>\n<tr>\n<td>95\n</td>\n<td>Cha.Sa.Chi.30/273\n</td>\n<td>Used in the treatment of Dorgandhya Stanya dosha.\n</td></tr>\n<tr>\n<td>96\n</td>\n<td>Cha.Sa.Chi.30/277\n</td>\n<td>Used in the treatment of Pichhila stanya.\n</td></tr>\n</tbody></table>\n<h2><span class=\"mw-headline\" id=\"Ayurvedic_pharmacological_properties\">Ayurvedic pharmacological properties</span></h2>\n<table class=\"wikitable\">\n<caption>Properties\n</caption>\n<tbody><tr>\n<th>Sr.no.</th>\n<th>Pharmacological criteria</th>\n<th>Properties\n</th></tr>\n<tr>\n<td>1</td>\n<td>Taste (<a href=\"/mediawiki-1.32.1/index.php?title=Rasa\" title=\"Rasa\">rasa</a>)</td>\n<td>Pungent (katu), Bitter(tikta)\n</td></tr>\n<tr>\n<td>2</td>\n<td>Potency (<a href=\"/mediawiki-1.32.1/index.php?title=Veerya\" title=\"Veerya\">veerya</a>)</td>\n<td>Hot (ushna)\n</td></tr>\n<tr>\n<td>3</td>\n<td>Post digestion effect (<a href=\"/mediawiki-1.32.1/index.php?title=Vipaka\" title=\"Vipaka\">vipaka</a>)</td>\n<td>Pungent (katu)\n</td></tr>\n<tr>\n<td>4</td>\n<td>Qualities (<a href=\"/mediawiki-1.32.1/index.php?title=Guna\" title=\"Guna\">guna</a>)</td>\n<td>Light (laghu), Sharp (tikshna)\n</td></tr>\n<tr>\n<td>5</td>\n<td>Actions (<a href=\"/mediawiki-1.32.1/index.php?title=Karma\" title=\"Karma\">karma</a>)</td>\n<td>Pacify Kapha and Vata\n</td></tr>\n</tbody></table>\n<h2><span class=\"mw-headli