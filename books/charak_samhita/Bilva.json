123\n</td>\n<td>As an ingredient  of dashamuladu ghrita.\n</td></tr>\n<tr>\n<td>73\n</td>\n<td>Cha.sa.chi.19/20\n</td>\n<td>As a pramathya dravya\n</td></tr>\n<tr>\n<td>74\n</td>\n<td>Cha.sa.chi.19/26\n</td>\n<td>As a Ingridient of dipaniya and sangrahi gana\n</td></tr>\n<tr>\n<td>75\n</td>\n<td>Cha.sa.chi.19/34\n</td>\n<td>As a yusha dravya\n</td></tr>\n<tr>\n<td>76\n</td>\n<td>Cha.sa.chi.19/35\n</td>\n<td>As a yusha dravya\n</td></tr>\n<tr>\n<td>77\n</td>\n<td>Cha.sa.chi.19/45\n</td>\n<td>As a anuvasana dravya\n</td></tr>\n<tr>\n<td>78\n</td>\n<td>Cha.sa.chi.19/48\n</td>\n<td>Use with paya for pana\n</td></tr>\n<tr>\n<td>79\n</td>\n<td>Cha.sa.chi.19/52\n</td>\n<td>As a yoga dravya in treatment of pittaj atisara.\n</td></tr>\n<tr>\n<td>80\n</td>\n<td>Cha.sa.chi.19/62\n</td>\n<td>As a anuvasana dravya\n</td></tr>\n<tr>\n<td>81\n</td>\n<td>Cha.sa.chi.19/104\n</td>\n<td>As a kwatha dravya\n</td></tr>\n<tr>\n<td>82\n</td>\n<td>Cha.sa.chi.19/109\n</td>\n<td>As a yoga dravya\n</td></tr>\n<tr>\n<td>83\n</td>\n<td>Cha.sa.chi.19/110\n</td>\n<td>As a yoga dravya\n</td></tr>\n<tr>\n<td>84\n</td>\n<td>Cha.sa.chi.19/113,\n</td>\n<td>As a yoga dravya\n</td></tr>\n<tr>\n<td>85\n</td>\n<td>Cha.sa.chi.19/114,\n</td>\n<td>As a main dravya in kaphaj atisara\n</td></tr>\n<tr>\n<td>86\n</td>\n<td>Cha.sa.chi.19/118,\n</td>\n<td>As a piccha basti dravya\n</td></tr>\n<tr>\n<td>87\n</td>\n<td>Cha.sa.chi.19/119\n</td>\n<td>As a anuvasana dravya\n</td></tr>\n<tr>\n<td>88\n</td>\n<td>Cha.Sa.Chi.20/23\n</td>\n<td>As a yusha  prayoga in Vataja chhardi.\n</td></tr>\n<tr>\n<td>89\n</td>\n<td>Cha.sa.Chi.24/129\n</td>\n<td>Used as anupana in vataja  madatyaya as an ingredient of panchamula.\n</td></tr>\n<tr>\n<td>90\n</td>\n<td>Cha.sa. Chi.25/78\n</td>\n<td>Used for parisechana in Daha &amp; shoola.\n</td></tr>\n<tr>\n<td>91\n</td>\n<td>Cha.sa.Chi.26/82\n</td>\n<td>As an ingredient of Punarnavadi taila for  vataja hrudroga.\n</td></tr>\n<tr>\n<td>92\n</td>\n<td>Cha.sa.Chi.26/135\n</td>\n<td>Used in Vataja pratishyaya  as dhoomavarti.\n</td></tr>\n<tr>\n<td>93\n</td>\n<td>Cha.sa.Chi.26/184\n</td>\n<td>Used in Kaphaja Siroroga  for Pradhamana nasya.\n</td></tr>\n<tr>\n<td>94\n</td>\n<td>Cha.sa.Chi.26/243\n</td>\n<td>As an ingredient of Amrutadi varti.\n</td></tr>\n<tr>\n<td>95\n</td>\n<td>Cha.Sa.Chi.27/29\n</td>\n<td>As an ingredient  of Urustambha nashak Yoga\n</td></tr>\n<tr>\n<td>96\n</td>\n<td>Cha.Sa.Chi.27/56\n</td>\n<td>As an ingredient  of Shyonakadi Parisheka and Pra;lepa\n</td></tr>\n<tr>\n<td>97\n</td>\n<td>Cha.Sa.Chi.28/97\n</td>\n<td>Used in the treatment of Nabhigata vata.\n</td></tr>\n<tr>\n<td>98\n</td>\n<td>Cha.Sa.Chi.28/123\n</td>\n<td>As an ingredient of Baladi ghrita.\n</td></tr>\n<tr>\n<td>99\n</td>\n<td>Cha.Sa.Chi.28/141\n</td>\n<td>As an ingredient of Yavadi taila.\n</td></tr>\n<tr>\n<td>100\n</td>\n<td>Cha.Sa.Chi.28/169\n</td>\n<td>As an ingredient of Mulakadhya taila.\n</td></tr>\n<tr>\n<td>101\n</td>\n<td>Cha.Sa.Chi.28/176\n</td>\n<td>As an ingredient of Mulaka taila.\n</td></tr>\n<tr>\n<td>102\n</td>\n<td>Cha.Sa.Chi.29/104\n</td>\n<td>As an ingredient of Amrutadhya taila.\n</td></tr>\n<tr>\n<td>103\n</td>\n<td>Cha.Sa.Chi.30/91\n</td>\n<td>As an ingredient of Pushyanuga churna.\n</td></tr>\n<tr>\n<td>104\n</td>\n<td>Cha.Sa.Chi.30/266\n</td>\n<td>Used in the treatment of Phena sanghat, As an  ingredient of Anjanadi lepa.\n</td></tr>\n<tr>\n<td>105\n</td>\n<td>Cha.Sa.Chi.30/278\n</td>\n<td>Used in the treatment of Pichhila stanya.\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Ayurvedic_pharmacological_properties\">Ayurvedic pharmacological properties</span></h2>\n<table class=\"wikitable\">\n<caption>Properties\n</caption>\n<tbody><tr>\n<th>Sr.no.</th>\n<th>Pharmacological criteria</th>\n<th>Properties\n</th></tr>\n<tr>\n<td>1</td>\n<td>Taste (<a href=\"/index.php?title=Rasa\" title=\"Rasa\">rasa</a>)</td>\n<td>Astringent (kashaya), Bitter (tikta)\n</td></tr>\n<tr>\n<td>2</td>\n<td>Potency (<a href=\"/index.php?title=Veerya\" title=\"Veerya\">veerya</a>)</td>\n<td>Hot (ushna)\n</td></tr>\n<tr>\n<td>3</td>\n<td>Post digestion effect (<a href=\"/index.php?title=Vipaka\" title=\"Vipaka\">vipaka</a>)</td>\n<td>Pungent (katu)\n</td></tr>\n<tr>\n<td>4</td>\n<td>Qualities (<a href=\"/index.php?title=Guna\" title=\"Guna\">guna</a>)</td>\n<td>Light (laghu), Rough (ruksha)\n</td></tr>\n<tr>\n<td>5</td>\n<td>Actions (<a href=\"/index.php?title=Karma\" title=\"Karma\">karma</a>)</td>\n<td>Pacify <a href=\"/index.php?title=Kapha\" class=\"mw-redirect\" title=\"Kapha\">kapha</a> and <a href=\"/index.php?title=Vata\" class=\"mw-redirect\" title=\"Vata\">vata</a>\n</td></tr>\n</tbody></table>\n<h2><span class=\"mw-headline\" id=\"Current_availability\">Current availability</span></h2>\n<p>Available \n</p>\n<h2><span class=\"mw-headline\" id=\"Current_researches\">Current researches</span></h2>\n<pre> This article is under development ..\n</pre>\n<!-- \nNewPP limit report\nCached time: 20250917114149\nCache expiry: 86400\nDynamic content: false\nComplications: []\nCPU time usage: 0.135 seconds\nReal time usage: 0.355 seconds\nPreprocessor visited node count: 67/1000000\nPost‐expand include size: 1050/2097152 bytes\nTemplate argument size: 0/2097152 bytes\nHighest expansion depth: 3/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nLua time usage: 0.200/7 seconds\nLua virtual size: 19.39 MB/200 MB\nLua estimated memory usage: 0 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  309.525      1 Template:Infobox\n100.00%  309.525      1 -total\n-->\n\n<!-- Saved in parser cache with key carakas1_carakasa:pcache:idhash:3657-0!canonical and timestamp 20250917114148 and revision id 43286\n -->\n</div></div><div class=\"printfooter\">Retrieved from \"<a dir=\"ltr\" href=\"https://www.carakasamhitaonline.com/index.php?title=Bilva&amp;oldid=43286\">https://www.carakasamhitaonline.com/index.php?title=Bilva&